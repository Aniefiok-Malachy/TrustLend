# Copy this file to .env and fill in your own values. NEVER commit the real .env file.

# The 12-word seed phrase of the wallet that will deploy/own the contract.
# Use a DEDICATED deployment wallet - not your main wallet.
TESTNET_MNEMONIC=""

# Same wallet's mnemonic, reused for mainnet deploys once you're ready to go live.
# Keeping this separate from TESTNET_MNEMONIC makes it easy to use a different
# wallet for mainnet if you want extra safety.
MAINNET_MNEMONIC=""
